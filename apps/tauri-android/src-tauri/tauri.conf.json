{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BCS Console",
  "version": "1.0.0",
  "identifier": "com.bcsconsole.tauri",
  "build": {
    "frontendDist": "../../web/dist",
    "devUrl": "http://192.168.0.101:8081"
  },
  "plugins": {
    "deep-link": {
      "mobile": [{ "scheme": ["bcsconsole"], "appLink": false }]
    }
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "BCS Console",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
